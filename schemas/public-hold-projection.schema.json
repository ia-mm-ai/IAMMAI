{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holding.world/schemas/public-hold-projection.schema.json",
  "title": "Public HOLD Projection",
  "description": "A bounded public projection of a HOLD already attributable to an external source record. Validation does not create or release the HOLD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_id",
    "projection_version",
    "presentation_basis",
    "target",
    "source",
    "hold",
    "effect_ceiling",
    "projection_sha256"
  ],
  "properties": {
    "projection_id": {
      "type": "string",
      "minLength": 1
    },
    "projection_version": {
      "type": "integer",
      "minimum": 1
    },
    "presentation_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_presentation_authorized",
        "basis_id"
      ],
      "properties": {
        "public_presentation_authorized": {
          "const": true
        },
        "basis_id": {
          "type": "string",
          "minLength": 1
        },
        "basis_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "public_label",
        "scope"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "public_label": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originating_locality",
        "record_id",
        "record_uri",
        "record_sha256"
      ],
      "properties": {
        "originating_locality": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_uri": {
          "type": "string",
          "format": "uri"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progression_posture",
        "recorded_at",
        "public_summary",
        "uncertainty",
        "release_requires_separate_source_record"
      ],
      "properties": {
        "progression_posture": {
          "const": "HELD"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "public_summary": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "review_condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_requires_separate_source_record": {
          "const": true
        }
      }
    },
    "effect_ceiling": {
      "type": "array",
      "items": {
        "enum": [
          "PUBLIC_PRESENTATION_ONLY",
          "NO_HOLD_ORIGINATION",
          "NO_MATTER_ADMISSION",
          "NO_AUTHORITY_CREATION",
          "NO_TRUTH_ADOPTION",
          "NO_PROGRESSION",
          "NO_RELEASE",
          "NO_CONSEQUENCE",
          "NO_SHARED_CURRENTNESS"
        ]
      },
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true
    },
    "release_projection": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "source_record_uri",
        "source_record_sha256"
      ],
      "properties": {
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_record_uri": {
          "type": "string",
          "format": "uri"
        },
        "source_record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "projection_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
